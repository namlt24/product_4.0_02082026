                        wrongPromotions = false;
                        break;
                    }
                }
            }
        } else {
            wrongPromotions = false;
        }
        if (wrongPromotions) {
            throw new LogicException("sale.wired.connect.custOrderDetail.promotion.not.map.action", "sale.wired.connect.custOrderDetail.promotion.not.map.action");
        }
