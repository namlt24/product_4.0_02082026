# Copy file nay thanh .env roi chinh sua (docker compose tu doc .env cung thu muc).
# Dev/demo dung chung ha tang BCCS (db-local): KHONG can sua gi, gia tri mac dinh
# trong docker-compose.yml da tro san dung. Trien khai RIENG cho 1 doi (Oracle 19c/
# Redis/Elasticsearch cua chinh doi do): dien day du cac bien duoi day - xem
# DEPLOYMENT_GUIDE.md de biet chi tiet tung buoc.

# Ma dinh danh doi - dung de phan biet instance trong ten service (SPRING_APPLICATION_NAME)
# va trong APM (ELASTIC_APM_SERVICE_NAME) neu nhieu doi cung feed 1 he thong log/APM
# chung. Khong bat buoc - bo trong van chay dung, chi kem "-default" chung chung.
TEAM_CODE=

# ---- Oracle (bat buoc dien day du khi trien khai rieng, xem Giai doan 0 - Flyway
# trong DEPLOYMENT_GUIDE.md: instance MOI phai chay Flyway migration truoc khi dung
# duoc, KHONG con dung Hibernate ddl-auto tu sinh schema nua) ----
DB_HOST=host.docker.internal
DB_PORT=1521
DB_NAME=FREEPDB1
DB_USER=BCCS_PRODUCT
DB_PASSWORD=BCCS_PRODUCT123

# ---- Redis: mac dinh dung container "redis" di kem trong chinh docker-compose.yml
# nay (moi doi tu trien khai deu co Redis rieng qua chinh container nay, khong can
# sua gi them - REDIS_HOST/PORT khong doc tu .env vi da co container sibling). ----

# ---- API key bao ve Control Plane (/api/**, dang nhap trang quan tri) - xem
# ApiKeyAuthFilter. BAT BUOC doi gia tri that khi trien khai that, khong dung
# default cua app. ----
GATEWAY_ADMIN_API_KEY=changeme-local-dev

# ---- Rate limit Data Plane (bao ve Upstream that phia sau) - xem RateLimitFilter.
# Gia tri mac dinh hop ly cho dev/demo, chinh lai neu can theo tai thuc te cua doi. ----
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_MAX_REQUESTS=300

# ---- Audit log (request/hop, phuc vu trang "Tra cuu Log") - xem AuditLogService.
# Fail-open: neu doi CHUA co Elasticsearch rieng, dat GATEWAY_AUDIT_ENABLED=false
# de tat han (khong anh huong traffic that du bat/tat). ----
GATEWAY_AUDIT_ENABLED=true
GATEWAY_AUDIT_ES_HOST=host.docker.internal
ES_PORT=9200

# ---- Elastic APM Java agent (tuy chon - agent tu tat neu khong ket noi duoc,
# khong chan traffic that). Bo trong ca 2 bien duoi neu doi chua co APM Server. ----
APM_SERVER_HOST=host.docker.internal
APM_SERVER_PORT=8200
APM_ENVIRONMENT=local
