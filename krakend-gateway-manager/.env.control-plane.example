# Copy file nay thanh .env roi chinh sua (docker compose tu doc .env cung thu muc).
# Danh cho docker-compose.control-plane.yml (1 doi nen tang chay 1 LAN DUY NHAT,
# dung chung MOI doi - xem .env.data-plane.example neu ban la 1 doi BCCS tu trien
# khai Data Plane rieng, KHONG phai file nay).

# ---- Oracle TRUNG TAM (dung chung MOI doi) - bat buoc dien day du khi trien khai
# that. Schema da duoc DBA tao san qua ban giao DDL (xem DEPLOYMENT_GUIDE.md muc 2 +
# backend/src/main/resources/db/team-schema/), KHONG dung Hibernate ddl-auto tu sinh
# schema. ----
DB_HOST=host.docker.internal
DB_PORT=1521
DB_NAME=FREEPDB1
DB_USER=BCCS_PRODUCT
DB_PASSWORD=BCCS_PRODUCT123

# ---- platform-admin key - CHI dung cho "/api/teams/**" (man hinh Quan ly doi) -
# xem ApiKeyAuthFilter. BAT BUOC doi gia tri that khi trien khai that. KHAC voi
# api_key rieng cua tung doi (do TeamController tu sinh khi tao doi, khong khai
# bao o day). ----
GATEWAY_ADMIN_API_KEY=changeme-local-dev

# ---- Audit log (Tra cuu Log tren UI, chi doc duoc log do CHINH Control Plane nay
# ghi qua "Thu ngay" - xem AuditLogService/LogSearchService). Fail-open: neu chua co
# Elasticsearch, dat GATEWAY_AUDIT_ENABLED=false. ----
GATEWAY_AUDIT_ENABLED=true
GATEWAY_AUDIT_ES_HOST=host.docker.internal
ES_PORT=9200
GATEWAY_AUDIT_RETENTION_DAYS=3

# ---- Elastic APM Java agent (tuy chon - agent tu tat neu khong ket noi duoc,
# khong chan traffic that). Bo trong ca 2 bien duoi neu chua co APM Server. ----
APM_SERVER_HOST=host.docker.internal
APM_SERVER_PORT=8200
APM_ENVIRONMENT=local
