# ============================================================================
# MAU tham khao - KHONG apply file nay truc tiep, va KHONG commit ban da dien
# mat khau that vao git.
#
# Cach lam DUNG (khuyen nghi, khong luu mat khau trong bat ky file YAML nao):
#
#   kubectl create secret generic gwm-secret -n <namespace-control-plane> \
#     --from-literal=DB_USER='GATEWAY_MANAGER' \
#     --from-literal=DB_PASSWORD='<mat-khau-that>' \
#     --from-literal=GATEWAY_ADMIN_API_KEY='<tu-sinh-1-khoa-manh>'
#
# GATEWAY_ADMIN_API_KEY o day la PLATFORM-ADMIN KEY (chi dung cho
# "/api/teams/**" - man hinh Quan ly doi, xem ApiKeyAuthFilter) - KHAC voi
# api_key rieng cua tung doi trong bang gwm_team (do TeamController tu sinh
# ra khi tao doi, khong khai bao o day).
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: gwm-secret
  labels:
    app.kubernetes.io/name: gateway-manager
    app.kubernetes.io/component: control-plane
type: Opaque
stringData:
  DB_USER: "GATEWAY_MANAGER"
  DB_PASSWORD: "<dien-mat-khau-that-truoc-khi-tu-tao-secret-rieng>"
  GATEWAY_ADMIN_API_KEY: "<tu-sinh-1-khoa-manh-KHONG-dung-gia-tri-mau>"
