# Copy file nay thanh .env roi chinh sua (docker compose tu doc .env cung thu muc).
# Danh cho docker-compose.data-plane.yml (MOI DOI BCCS tu chay 1 ban RIENG cua chinh
# minh - xem .env.control-plane.example neu ban la doi nen tang trien khai Control
# Plane, KHONG phai file nay).

# ---- Dieu kien tien quyet: da co team_code + api_key do DOI NEN TANG cap qua man
# hinh "Quan ly doi" tren UI Control Plane trung tam (dang nhap bang platform-admin
# key, hien api_key DUNG 1 LAN luc tao) - can 2 gia tri nay TRUOC khi dien file nay. ----
TEAM_CODE=
CONTROL_PLANE_BASE_URL=http://gwm-api.trung-tam.local
CONTROL_PLANE_SYNC_API_KEY=
CONTROL_PLANE_SYNC_INTERVAL_SECONDS=15

# ---- Redis: mac dinh dung container "redis" di kem trong chinh
# docker-compose.data-plane.yml (khong can sua gi them). ----

# ---- Rate limit traffic that (bao ve Upstream that phia sau) - xem RateLimitFilter.
# Gia tri mac dinh hop ly cho dev/demo, chinh lai neu can theo tai thuc te cua doi. ----
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_MAX_REQUESTS=300

# ---- Audit log (request/hop, ghi vao ES CUA DOI) - xem AuditLogService. Fail-open:
# neu doi CHUA co Elasticsearch rieng, dat GATEWAY_AUDIT_ENABLED=false. ----
GATEWAY_AUDIT_ENABLED=true
GATEWAY_AUDIT_ES_HOST=host.docker.internal
ES_PORT=9200
GATEWAY_AUDIT_RETENTION_DAYS=3

# ---- Elastic APM Java agent (tuy chon - agent tu tat neu khong ket noi duoc,
# khong chan traffic that). Bo trong ca 2 bien duoi neu doi chua co APM Server. ----
APM_SERVER_HOST=host.docker.internal
APM_SERVER_PORT=8200
APM_ENVIRONMENT=local
