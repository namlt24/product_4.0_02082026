# ============================================================================
# MAU tham khao - KHONG apply file nay truc tiep, va KHONG commit ban da dien
# mat khau that vao git (dat ten ".example" co y, kem .gitignore chan
# "01-secret.yaml" that - xem cuoi file).
#
# Cach lam DUNG (khuyen nghi, khong luu mat khau trong bat ky file YAML nao):
#
#   kubectl create secret generic gwm-secret -n <namespace-cua-doi> \
#     --from-literal=DB_USER='GATEWAY_MANAGER' \
#     --from-literal=DB_PASSWORD='<mat-khau-that-cua-doi>' \
#     --from-literal=GATEWAY_ADMIN_API_KEY='<tu-sinh-1-khoa-manh>'
#
# Neu bat buoc phai quan ly qua file YAML (vd GitOps voi sealed-secrets/
# external-secrets - ngoai pham vi bo manifest co ban nay), dien gia tri thieu
# duoi day roi tu ma hoa Base64 tung dong ("echo -n '<gia-tri>' | base64")
# truoc khi dat vao truong "data:" (KHONG dung "stringData:" cho ban se
# commit that - stringData luu ro chu, sealed-secrets/tool tuong duong moi
# chiu trach nhiem giai quyet van de nay dung cach).
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: gwm-secret
  labels:
    app.kubernetes.io/name: gateway-manager
type: Opaque
stringData:
  DB_USER: "GATEWAY_MANAGER"
  DB_PASSWORD: "<dien-mat-khau-that-truoc-khi-tu-tao-secret-rieng>"
  GATEWAY_ADMIN_API_KEY: "<tu-sinh-1-khoa-manh-KHONG-dung-gia-tri-mau>"
