# ============================================================================
# MAU tham khao - KHONG apply file nay truc tiep, va KHONG commit ban da dien
# key that vao git.
#
# Cach lam DUNG (khuyen nghi, khong luu key trong bat ky file YAML nao):
#
#   kubectl create secret generic gwm-secret -n <namespace-cua-doi> \
#     --from-literal=CONTROL_PLANE_SYNC_API_KEY='<api_key-doi-nen-tang-da-cap>'
#
# api_key nay do doi NEN TANG cap khi tao doi ban qua man hinh "Quan ly doi"
# tren UI Control Plane trung tam (hien DUNG 1 LAN luc tao, xem
# ../control-plane/README.md) - KHONG phai platform-admin key (gwm-secret cua
# ban Control Plane, khac hoan toan).
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: gwm-secret
  labels:
    app.kubernetes.io/name: gateway-manager
    app.kubernetes.io/component: data-plane
type: Opaque
stringData:
  CONTROL_PLANE_SYNC_API_KEY: "<dien-api_key-doi-nen-tang-da-cap-cho-doi-ban>"
