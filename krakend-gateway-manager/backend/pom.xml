<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 4.0.8: cung nhanh Spring Boot 4.x ma bccs-build-parent noi bo dang dung
             (xac nhan qua log that cua product-catalog-service: spring-boot-maven-
             plugin:4.0.7) - ban nay ho tro repackage bytecode JDK 25 dung ("Unsupported
             class file major version 69" chi xay ra voi 3.3.4 cu). -->
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.bccs</groupId>
    <artifactId>krakend-gateway-manager</artifactId>
    <version>1.0.0</version>
    <name>krakend-gateway-manager</name>
    <description>Dynamic Composite API Orchestrator - Control Plane + Gateway thuc thi (khong con phu thuoc KrakenD/Gravitee)</description>
    <packaging>jar</packaging>

    <properties>
        <!-- Spring Boot 4.0.8 ho tro repackage bytecode JDK 25 dung - dich thang
             len 25, khong con can gh-compile bytecode 21 nhu truoc. Docker build
             (xem Dockerfile) doi tuong ung sang JDK 25. -->
        <java.version>25</java.version>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencies>
        <!-- REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot 4: RestTemplateBuilder da tach khoi starter-web, chuyen sang
             module rieng spring-boot-restclient (package moi org.springframework.boot.
             restclient.RestTemplateBuilder) - can khai bao tuong minh de UpstreamHttpExecutor
             dung duoc RestTemplateBuilder nhu truoc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Persistence: luu cau hinh Endpoint / BackendStep / FieldMapping / UpstreamService -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Redis: cache-aside cho cac lan goi GET toi Upstream (xem GatewayCacheService) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Resilience4j: circuit breaker/retry/bulkhead theo tung Upstream (xem UpstreamHttpExecutor).
             Project nay doc lap (khong ke thua bccs-build-parent) nen khong vuong rang buoc
             "chi dung BCCS starter" cua 6 service nen tang - them thoai mai.
             Dung ban -spring-boot4 (khong phai -spring-boot3) de khop Spring Boot 4.x. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- Validation cho request DTO -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Dung chung Oracle instance + schema BCCS_PRODUCT voi cac service BCCS
             (khong con Postgres rieng nua). -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.6.0.24.10</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- Ghi de version quan ly boi spring-boot-starter-parent: ban cu hon
                 khong ho tro annotation processor tren JDK moi (vi du JDK 25), khien
                 Lombok "im lang" khong sinh code (getter/setter/@Slf4j...) ma khong
                 bao loi ro rang. Dung ban moi nhat tuong thich JDK hien tai. -->
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Ghi log co cau truc (audit request/hop) thang vao Elasticsearch dung chung
             cua he thong BCCS (xem db-local/docker-compose.yml - bccs-elasticsearch 8.15.3)
             - dung dung version client khop version server de giam rui ro lech version,
             KHONG dung lai 8.4.3 ma product-policy-service dang dung (client noi bo rieng
             cua ho, khong ap dung o day). Client nay dung jakarta.json (JSON-P) de serialize,
             DOC LAP voi Jackson cua app (tranh dung cham voi viec repo dang dung xen ke
             tools.jackson/com.fasterxml.jackson). -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
            <version>8.15.3</version>
        </dependency>
        <!-- elasticsearch-java can dung 1 JsonpMapper - dung JacksonJsonpMapper (huong dan
             chinh thuc cua Elastic), can jackson-databind CLASSIC (com.fasterxml.jackson,
             Jackson 2.x) - day la 1 artifact HOAN TOAN KHAC voi tools.jackson (Jackson 3)
             app dang dung cho Spring MVC, khong dung chung namespace/package nen khong xung
             dot classpath, chi la 2 cay Jackson doc lap cung ton tai. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- JacksonJsonpMapper KHONG tu dang ky module java.time (Instant...) mac dinh -
             thieu module nay se lam moi lan bulk index audit log loi ngam (fail-open nen
             KHONG lam sap traffic that, nhung log se rong hoan toan ma khong ro nguyen
             nhan neu khong them dependency nay + dang ky trong ElasticsearchConfig). -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- API goi trace.id hien tai (link audit log sang APM trace) - Elastic thiet ke
             module nay de LUON an toan dua vao du an dung: cac phuong thuc tra ve gia
             tri no-op/null neu KHONG co Java agent that su duoc gan qua -javaagent (xem
             backend/Dockerfile) - khong throw, khong can if/reflection thu cong. Rieng
             biet voi ban than agent (agent la 1 file .jar tai rieng, gan bang -javaagent,
             KHONG phai dependency Maven). -->
        <dependency>
            <groupId>co.elastic.apm</groupId>
            <artifactId>apm-agent-api</artifactId>
            <version>1.56.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gateway-manager</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Truoc JDK 25: javac tu do tim annotation processor (Lombok) tren
                         classpath thong thuong, chi in WARNING la mot ban release tuong lai
                         co the tat kha nang nay tru khi khai bao ro processor path rieng.
                         JDK 25 chinh la "ban release tuong lai" do - no BO HAN co che tu do,
                         khien Lombok "im lang" khong sinh getter/setter/@Slf4j... ma khong bao
                         loi ro rang (da xac nhan bang cach chay truc tiep javac voi va khong
                         voi processorpath rieng). Khai bao annotationProcessorPaths tuong minh
                         la fix dung (khong phai workaround) - day cung la cach lam duoc khuyen
                         nghi chung, khong phu thuoc hanh vi tu do sap bi go bo cua javac. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
