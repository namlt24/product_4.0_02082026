# Copy file nay thanh .env roi chinh sua neu can (docker compose tu doc .env cung thu muc).
# Mac dinh trong docker-compose.yml da tro san toi Oracle CHUNG voi BCCS (db-local,
# schema BCCS_PRODUCT) - chi can tao file nay neu muon doi khac credential mac dinh.
DB_NAME=FREEPDB1
DB_USER=BCCS_PRODUCT
DB_PASSWORD=BCCS_PRODUCT123

# API key bao ve Control Plane (/api/**, dang nhap trang quan tri) - xem ApiKeyAuthFilter.
# BAT BUOC doi gia tri that khi trien khai that, khong dung default cua app.
GATEWAY_ADMIN_API_KEY=changeme-local-dev
